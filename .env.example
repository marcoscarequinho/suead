# Porta do servidor Node
PORT=3000
NODE_ENV=development

# Banco de dados (Neon Postgres)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Sessao de login (gere um valor aleatorio longo)
SESSION_SECRET=

# URL publica da aplicacao (usada nos retornos do checkout)
BASE_URL=http://localhost:3000

# Mercado Pago
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=

# Geracao de avatares (HeyGen, Synthesia ou D-ID)
AVATAR_API_KEY=
AVATAR_PROVIDER=heygen

# Voz dos avatares (opcional). Sem chave, usa a voz do navegador.
TTS_API_KEY=
TTS_PROVIDER=

# Assistente de duvidas (LLM) — API da Anthropic (console.anthropic.com).
# Sem LLM_API_KEY o tira-duvidas responde em modo simulado (texto fixo).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
