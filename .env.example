# Porta do servidor Node
PORT=3000
NODE_ENV=development

# Banco de dados (Neon Postgres)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Sessao de login (gere um valor aleatorio longo)
SESSION_SECRET=

# URL publica da aplicacao (usada nos retornos do checkout)
BASE_URL=http://localhost:3000

# Mercado Pago
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=

# Geracao de avatares (HeyGen, Synthesia ou D-ID)
AVATAR_API_KEY=
AVATAR_PROVIDER=heygen

# Voz dos avatares (opcional). Sem chave, usa a voz do navegador.
TTS_API_KEY=
TTS_PROVIDER=

# Assistente de duvidas (LLM) — API da Anthropic (console.anthropic.com).
# Sem LLM_API_KEY o tira-duvidas responde em modo simulado (texto fixo).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# ---- Divulgacao diaria nos grupos de WhatsApp ----
# A API oficial da Meta nao envia para grupos: use um gateway.
# Escolha um provedor: zapi | evolution. Vazio = modo simulado (so' loga).
WHATSAPP_PROVIDER=

# Z-API (https://z-api.io) — painel da instancia
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Evolution API (self-hosted)
EVOLUTION_URL=https://sua-evolution.com.br
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# Texto e link do disparo (opcionais — ha padrao no codigo)
DIVULGACAO_LINK=https://www.suead.com.br/
DIVULGACAO_TEXTO=
DIVULGACAO_INTERVALO_MS=8000

# Protege a rota /api/cron/* — a Vercel envia como Bearer token.
# Gere um valor aleatorio longo e cadastre igual no painel da Vercel.
CRON_SECRET=
