<footer class="rodape">
  <div class="rodape-grade">
    <div class="rodape-marca">
      <div class="logo logo-claro"><span class="logo-marca">EducaAI</span> <span aria-hidden="true">🚀</span></div>
      <p>Professores avatares de inteligência artificial que ensinam do básico ao avançado, no seu ritmo, a qualquer hora.</p>
      <div class="redes" aria-label="Redes sociais">
        <a href="#" aria-label="Instagram">Instagram</a>
        <a href="#" aria-label="YouTube">YouTube</a>
        <a href="#" aria-label="TikTok">TikTok</a>
        <a href="#" aria-label="LinkedIn">LinkedIn</a>
      </div>
    </div>

    <div>
      <h3>Matérias</h3>
      <ul>
        <li><a href="/materias/matematica">Matemática</a></li>
        <li><a href="/materias/historia">História</a></li>
        <li><a href="/materias/geografia">Geografia</a></li>
        <li><a href="/materias/portugues">Português</a></li>
      </ul>
    </div>

    <div>
      <h3>Plataforma</h3>
      <ul>
        <li><a href="/#como-funciona">Como funciona</a></li>
        <li><a href="/#planos">Planos e preços</a></li>
        <li><a href="/#depoimentos">Depoimentos</a></li>
        <li><a href="/area-do-aluno">Área do aluno</a></li>
        <li><a href="/forum">Fórum</a></li>
      </ul>
    </div>

    <div>
      <h3>Institucional</h3>
      <ul>
        <li><a href="#">Termos de uso</a></li>
        <li><a href="#">Política de privacidade</a></li>
        <li><a href="#">Central de ajuda</a></li>
        <li><a href="#">Fale conosco</a></li>
      </ul>
    </div>
  </div>

  <div class="rodape-base">
    <p>&copy; <%= new Date().getFullYear() %> EducaAI. Todos os direitos reservados.</p>
    <p>Feito com Node.js · O futuro da educação chegou.</p>
  </div>
</footer>

<% if (typeof aluno !== 'undefined' && aluno && aluno.tipo !== 'admin') { %>
<!-- Chat com o admin (respondido por gente, não pela IA) -->
<button type="button" class="suporte-flutuante" id="suporte-abrir" aria-label="Falar com o suporte" aria-expanded="false">
  💬<span class="badge" id="suporte-badge" hidden>0</span>
</button>
<div class="suporte-painel" id="suporte-painel" hidden>
  <div class="suporte-painel-topo">
    <span>Fale com o suporte</span>
    <button type="button" id="suporte-fechar" aria-label="Fechar chat">✕</button>
  </div>
  <div class="suporte-mensagens" id="suporte-mensagens">
    <p class="suporte-vazio">Mande sua dúvida — quem responde aqui é a nossa equipe, não a IA.</p>
  </div>
  <form class="suporte-form" id="suporte-form">
    <input type="text" id="suporte-texto" placeholder="Digite sua mensagem…" maxlength="1000" autocomplete="off" required>
    <button type="submit" aria-label="Enviar">➤</button>
  </form>
</div>
<script src="/js/suporte.js" defer></script>
<% } else if (typeof aluno === 'undefined' || !aluno) { %>
<a href="/login" class="suporte-flutuante" aria-label="Entrar para falar com o suporte" title="Entre para falar com o suporte">💬</a>
<% } %>

<script src="/js/voz.js" defer></script>
<script src="/js/main.js" defer></script>
</body>
</html>
